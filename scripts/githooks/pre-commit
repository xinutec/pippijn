#!/usr/bin/env bash
# Single health gate. A commit must be healthy: this runs the full gate — the
# rows live in gate.dhall, rendered to the committed gate.json, and are run by
# dev-lint's shared runner rather than by a script in this repository. There is
# NO separate pre-push step.
#
# ⚠ This repository had a hook before this one and it ran NOTHING. It lived in
# `code/kubes/scripts/githooks/`, dispatched on a list of in-tree apps, and every
# app had moved to its own repo — so `APPS=""` and it `exit 0`ed on every commit.
# Meanwhile gate.dhall's three rows, including the cluster-model drift check
# whose absence had already let five hand-edits into a generated manifest, ran
# nowhere. DL-GIT-PRECOMMIT-GATE says exactly this, and could not see it: the
# rule reads a repo's ROOT, and `check`'s LINT_EXEMPT keeps this root out of the
# linter. Hence the hook at the root now, where the convention puts it and where
# the rule looks.
#
# Slow by design; we optimise for healthy commits, not commit speed.
# Quiet on success: the gate's output is printed only when it FAILS, so a
# healthy commit isn't buried under build/test noise (DL-GIT-PRECOMMIT-GATE).
# Bypass a genuine work-in-progress commit with:  git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! out=$(nix run "git+file:../dev-lint?ref=HEAD#gate" -- . gate.json 2>&1); then
  printf '%s\n' "$out" >&2
  exit 1
fi
